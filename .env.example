# このファイルを .env.local にコピーして値を設定してください。
# .env.local は git 管理外です。

# ログインパスワード（8 文字以上）。
# 本番（npm start）では必須。未設定だとアプリは一切データを返さず、
# 設定を促す画面を出します。開発（npm run dev）で未設定の場合は
# 認証なしで動きます。
MEISHI_PASSWORD=

# セッション Cookie の署名鍵（任意、推奨）。
# 未設定の場合は MEISHI_PASSWORD から導出します。その場合、パスワードを
# 変更すると全端末のログインが切れます。明示しておくとパスワード変更後も
# ログイン状態が維持されます。
# 生成例: openssl rand -base64 32
MEISHI_SESSION_SECRET=

# API 用トークン（任意）。設定すると /api/* に
# `Authorization: Bearer <トークン>` でアクセスできます。
# 未設定なら API はログイン済みブラウザからのみ利用できます。
# 生成例: openssl rand -hex 32
MEISHI_API_TOKEN=

# ログインの有効期間（日数、任意）。既定 30。
MEISHI_SESSION_DAYS=30

# HTTPS 終端をリバースプロキシに任せていて X-Forwarded-Proto を
# 送らない構成の場合に 1 を設定すると、Cookie に Secure を付けます。
# 通常は自動判定されるので設定不要です。
MEISHI_SECURE_COOKIE=

# データの保存先（任意）
# MEISHI_DB_PATH=data/cards.db
# MEISHI_UPLOAD_DIR=data/uploads
